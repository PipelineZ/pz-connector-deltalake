<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Testcontainers.Minio/Testcontainers.Azurite pin a transitive SSH.NET with a known advisory;
         it is a Docker-exec dependency of the test-only Testcontainers packages, never shipped in
         Pz.Connector.DeltaLake itself, so silencing the audit here does not affect the package. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pz.Connector.DeltaLake\Pz.Connector.DeltaLake.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="golden\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pz.Connectors.TestKit" Version="0.6.1" />
    <!-- Test-only: reproduces pz's own ConnectorConfigValidator.ValidateSchema evaluation
         (JsonSchema.Net 9.2.2, the exact version Pz.Engine pins) against the shipped
         DeltaLakeSchemas.Dataset text, so the not+pattern calendar-token guard is verified
         end to end rather than approximated against a bare .NET Regex copy. Never referenced
         from Pz.Connector.DeltaLake.csproj: the shipped connector does not evaluate its own
         schema, pz does. -->
    <PackageReference Include="JsonSchema.Net" Version="9.2.2" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
    <!-- Test-only: parses the fenced yaml examples in the committed documentation so a copy-pasted
         example that pz or this connector would refuse fails the build. 18.1.0 is the version
         pz's own loader parses connections.yml with, so an example that parses here parses there. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- Object-store backends, test-only. The Testcontainers versions and the image tags the
         suites pin match the ones pz's own S3/AzureBlob suites run against, so this connector is
         measured on the same emulator builds the rest of the ecosystem is. AWSSDK.S3 and
         Azure.Storage.Blobs exist here for ONE call each: creating the bucket and the blob
         container, which neither delta-rs nor DuckDB can create for themselves. -->
    <PackageReference Include="Testcontainers.Minio" Version="4.13.0" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.13.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
  </ItemGroup>

</Project>
